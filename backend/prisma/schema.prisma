// Bank-Client System Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// COMPANIES & USERS
// ============================================

model Company {
  id         String   @id @default(uuid())
  name       String
  inn        String   @unique @db.VarChar(12)
  kpp        String?  @db.VarChar(9)
  ogrn       String?  @db.VarChar(15)
  status     CompanyStatus @default(ACTIVE)

  // JSON field for limits and configurations
  limitsJson Json?    @map("limits_json")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  users         User[]
  accounts      Account[]
  counterparties Counterparty[]
  payments      Payment[]
  messages      Message[]
  auditLogs     AuditLog[]

  @@map("companies")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model User {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  email         String   @unique
  phone         String?
  passwordHash  String   @map("password_hash")

  role          UserRole
  permissions   String[] // Array of permission flags

  // MFA
  mfaEnabled    Boolean  @default(false) @map("mfa_enabled")
  mfaSecret     String?  @map("mfa_secret")

  // Status
  isActive      Boolean  @default(true) @map("is_active")
  isBlocked     Boolean  @default(false) @map("is_blocked")

  // Limits (JSON)
  limitsJson    Json?    @map("limits_json")

  // Audit fields
  lastLoginAt   DateTime? @map("last_login_at")
  lastLoginIp   String?   @map("last_login_ip")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdPayments    Payment[] @relation("CreatedPayments")
  signedPayments     PaymentSignature[]
  uploadedFiles      PaymentFile[]
  messageReplies     Message[] @relation("MessageReplies")
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]

  @@index([companyId, email])
  @@index([companyId, isActive])
  @@map("users")
}

enum UserRole {
  ADMIN
  OPERATOR
  SIGNER
  VIEWER
}

model RefreshToken {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================
// ACCOUNTS & STATEMENTS
// ============================================

model Account {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  accountNo   String   @unique @map("account_no") @db.VarChar(20)
  bic         String   @db.VarChar(9)
  bankName    String   @map("bank_name")
  currency    String   @default("RUB") @db.VarChar(3)
  balance     Decimal  @default(0) @db.Decimal(15, 2)

  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments    Payment[]
  statements  Statement[]

  @@index([companyId])
  @@map("accounts")
}

model Statement {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  dateFrom    DateTime @map("date_from") @db.Date
  dateTo      DateTime @map("date_to") @db.Date

  fileUrl     String?  @map("file_url")
  sha256      String?  @db.VarChar(64)

  // Metadata (totals, counts, etc.)
  metaJson    Json?    @map("meta_json")

  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, dateFrom, dateTo])
  @@map("statements")
}

// ============================================
// COUNTERPARTIES
// ============================================

model Counterparty {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")

  name        String   @db.VarChar(160)
  inn         String   @db.VarChar(12)
  kpp         String?  @db.VarChar(9)
  accountNo   String   @map("account_no") @db.VarChar(20)
  bic         String   @db.VarChar(9)

  // Additional metadata
  metaJson    Json?    @map("meta_json")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@index([companyId, inn])
  @@map("counterparties")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  accountId       String        @map("account_id")
  counterpartyId  String?       @map("counterparty_id")

  // Document info
  docNumber       String?       @map("doc_number") @db.VarChar(20)
  date            DateTime      @db.Date

  // Amount
  amount          Decimal       @db.Decimal(15, 2)
  currency        String        @default("RUB") @db.VarChar(3)

  // Receiver details
  receiverName    String        @map("receiver_name") @db.VarChar(160)
  receiverInn     String        @map("receiver_inn") @db.VarChar(12)
  receiverKpp     String?       @map("receiver_kpp") @db.VarChar(9)
  receiverAccount String        @map("receiver_account") @db.VarChar(20)
  receiverBic     String        @map("receiver_bic") @db.VarChar(9)

  // Purpose
  purpose         String        @db.VarChar(210)

  // Budget fields (optional)
  kbk             String?       @db.VarChar(20)
  oktmo           String?       @db.VarChar(11)
  uip             String?       @db.VarChar(25)

  // Priority
  priority        Int           @default(5) @db.SmallInt

  // Status & workflow
  status          PaymentStatus @default(DRAFT)

  // Bank reference after sending
  bankRef         String?       @map("bank_ref")
  valueDate       DateTime?     @map("value_date") @db.Date

  // Rejection/return info
  rejectionReason String?       @map("rejection_reason")

  // Internal comment
  commentInternal String?       @map("comment_internal") @db.Text

  // Audit
  createdBy       String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  sentAt          DateTime?     @map("sent_at")

  // Relations
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  counterparty    Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  creator         User          @relation("CreatedPayments", fields: [createdBy], references: [id], onDelete: Restrict)

  signatures      PaymentSignature[]
  files           PaymentFile[]
  history         PaymentHistory[]

  @@index([companyId, status])
  @@index([accountId, date])
  @@index([companyId, createdAt])
  @@map("payments")
}

enum PaymentStatus {
  DRAFT
  ON_APPROVAL
  SIGNED
  SENT
  BANK_ACCEPTED
  POSTED
  REJECTED
  RETURNED
}

model PaymentSignature {
  id              String   @id @default(uuid())
  paymentId       String   @map("payment_id")
  userId          String   @map("user_id")

  signatureType   String   @map("signature_type") @db.VarChar(20) // CMS, CAdES
  signatureData   String   @map("signature_data") @db.Text // base64
  certThumbprint  String   @map("cert_thumbprint") @db.VarChar(64)
  certChain       String?  @map("cert_chain") @db.Text // JSON array

  isValid         Boolean  @default(true) @map("is_valid")

  signedAt        DateTime @default(now()) @map("signed_at")

  // Relations
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_signatures")
}

model PaymentFile {
  id          String          @id @default(uuid())
  paymentId   String          @map("payment_id")

  fileUrl     String          @map("file_url")
  fileName    String          @map("file_name")
  fileSize    Int             @map("file_size")
  mimeType    String          @map("mime_type")
  sha256      String          @db.VarChar(64)

  docType     VKDocType       @map("doc_type")
  status      VKDocStatus     @default(RECEIVED)

  uploadedBy  String          @map("uploaded_by")
  uploadedAt  DateTime        @default(now()) @map("uploaded_at")

  // Relations
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploader    User            @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_files")
}

enum VKDocType {
  CONTRACT
  INVOICE
  SUPPORTING
  OTHER
}

enum VKDocStatus {
  RECEIVED
  UNDER_REVIEW
  APPROVED
  NEEDS_CORRECTION
}

model PaymentHistory {
  id          String        @id @default(uuid())
  paymentId   String        @map("payment_id")

  fromStatus  PaymentStatus? @map("from_status")
  toStatus    PaymentStatus  @map("to_status")

  comment     String?       @db.Text
  metadata    Json?         // Additional data (user, IP, etc.)

  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_history")
}

// ============================================
// MESSAGES
// ============================================

model Message {
  id              String      @id @default(uuid())
  companyId       String      @map("company_id")

  threadType      MessageThreadType @map("thread_type")
  relatedId       String?     @map("related_id") // ID платежа, документа и т.д.

  subject         String      @db.VarChar(255)
  body            String      @db.Text

  // Attachments as JSON array
  attachmentsJson Json?       @map("attachments_json")

  // Is this from bank or user reply
  isFromBank      Boolean     @default(true) @map("is_from_bank")

  // Reply info
  repliedBy       String?     @map("replied_by")
  repliedAt       DateTime?   @map("replied_at")

  // Read status
  isRead          Boolean     @default(false) @map("is_read")
  readAt          DateTime?   @map("read_at")

  createdAt       DateTime    @default(now()) @map("created_at")

  // Relations
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  replier         User?       @relation("MessageReplies", fields: [repliedBy], references: [id], onDelete: SetNull)

  @@index([companyId, isRead])
  @@index([companyId, threadType])
  @@map("messages")
}

enum MessageThreadType {
  GENERAL
  PAYMENT
  VK_DOCUMENT
  STATEMENT
  OTHER
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  userId      String?  @map("user_id")

  action      String   @db.VarChar(50) // LOGIN, CREATE_PAYMENT, SIGN_PAYMENT, etc.
  objectType  String?  @map("object_type") @db.VarChar(50) // Payment, User, etc.
  objectId    String?  @map("object_id")

  // Before/after state for changes
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")

  // Request metadata
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)

  // Result
  result      String?  @db.VarChar(20) // SUCCESS, FAILED, etc.
  errorMsg    String?  @map("error_msg") @db.Text

  // Trace ID for correlation
  traceId     String?  @map("trace_id") @db.VarChar(50)

  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([traceId])
  @@map("audit_logs")
}
